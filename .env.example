# Server-only. Never prefix with NEXT_PUBLIC_ — that would ship it to the browser.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Poller-only extras (set as GitLab CI/CD variables in CI):
# RESEND_API_KEY=re_...
# ALERT_EMAIL_TO=you@example.com

# Staleness alert (npm run check-stale). Defaults: 90 and 360.
# STALE_AFTER_MINUTES=90              # two missed polls at the 30-min cadence
# STALE_ALERT_COOLDOWN_MINUTES=360    # at most one alert per 6h while down
# DASHBOARD_URL=https://your-app.vercel.app
# LLM grading — any OpenAI-compatible API. GitHub Models was retired 2026-07-30.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# MODEL=gpt-4o-mini
# GITHUB_TOKEN=ghp_...   # only for the GitHub Issue alert channel
